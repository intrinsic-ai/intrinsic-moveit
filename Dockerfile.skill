# Build up the skill with multi-stage layering on prebuilt SDK base images:
#   - source (adds local skill and interface packages on intrinsic_sdk_cmake)
#   - build (installs build deps and compiles only packages up to target skill)
#   - descriptors (scratch export stage for proto descriptor sets)
#   - exec_depends (captures runtime-only apt selections on intrinsic_sdk_cmake_run)
#   - runtime (minimal runtime image with exec deps and compiled skill install tree)

ARG REPOSITORY=ghcr.io/intrinsic-ai
ARG TAG=latest
ARG ROS_DISTRO=jazzy
ARG BASE_IMAGE_TAG=${TAG}-${ROS_DISTRO}

# =========================================================
# STAGE 1: SOURCE STAGE
# =========================================================
FROM ${REPOSITORY}/intrinsic_sdk_cmake:${BASE_IMAGE_TAG} AS source

WORKDIR /opt/service_workspace

ADD moveit_planning_interfaces /opt/service_workspace/src/moveit_planning_interfaces
ADD moveit_plan_motion_skill /opt/service_workspace/src/moveit_plan_motion_skill
ADD moveit_plan_grasp_skill /opt/service_workspace/src/moveit_plan_grasp_skill

# =========================================================
# STAGE 2: BUILD STAGE
# =========================================================
FROM source AS build

ARG ROS_DISTRO=jazzy
ARG SKILL_PACKAGE=moveit_plan_motion_skill

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    . /opt/ros/${ROS_DISTRO}/setup.sh \
    && . /opt/intrinsic/intrinsic_sdk_cmake/install/setup.sh \
    && set -x \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache \
    && apt-get update \
    && (rosdep init 2>/dev/null || true) \
    && rosdep update --rosdistro ${ROS_DISTRO} \
    && cd /opt/service_workspace \
    && mkdir -p /opt/selected_src \
    && for pkg_path in $(colcon list --base-paths src --packages-up-to ${SKILL_PACKAGE} -p); do \
        cp -r "$pkg_path" /opt/selected_src/; \
    done \
    && rosdep install \
        --from-paths /opt/selected_src \
        --ignore-src \
        -r -y \
    && apt-get install -y --no-install-recommends ccache python3-protobuf \
    && /usr/sbin/update-ccache-symlinks

RUN --mount=type=cache,target=/ccache/ \
    . /opt/ros/${ROS_DISTRO}/setup.sh \
    && . /opt/intrinsic/intrinsic_sdk_cmake/install/setup.sh \
    && set -x \
    && export CCACHE_DIR=/ccache \
    && export PATH="/usr/lib/ccache:$PATH" \
    && ccache -z \
    && cd /opt/service_workspace \
    && colcon build \
        --cmake-args -DCMAKE_BUILD_TYPE=Release -DBUILD_TESTING=OFF \
        --merge-install \
        --packages-up-to ${SKILL_PACKAGE} \
    && protoc \
        -I/opt/service_workspace/src/${SKILL_PACKAGE}/src/${SKILL_PACKAGE} \
        --descriptor_set_in=/opt/intrinsic/intrinsic_sdk_cmake/install/share/intrinsic_sdk_cmake/intrinsic_proto.desc \
        --descriptor_set_out=/opt/service_workspace/${SKILL_PACKAGE}_protos.desc \
        /opt/service_workspace/src/${SKILL_PACKAGE}/src/${SKILL_PACKAGE}/${SKILL_PACKAGE}.proto \
    && ccache -s

# =========================================================
# STAGE 3: DESCRIPTORS STAGE (BuildKit Local Export)
# =========================================================
FROM scratch AS descriptors

ARG SKILL_PACKAGE=moveit_plan_motion_skill

COPY --from=build \
    /opt/intrinsic/intrinsic_sdk_cmake/install/share/intrinsic_sdk_cmake/intrinsic_proto.desc \
    /intrinsic_proto.desc
COPY --from=build \
    /opt/service_workspace/${SKILL_PACKAGE}_protos.desc \
    /${SKILL_PACKAGE}_protos.desc

# =========================================================
# STAGE 4: EXEC_DEPENDS STAGE (Runtime Apt Selection)
# =========================================================
FROM ${REPOSITORY}/intrinsic_sdk_cmake_run:${BASE_IMAGE_TAG} AS exec_depends

ARG ROS_DISTRO=jazzy

COPY --from=build /opt/selected_src /opt/service_workspace/src

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    . /opt/ros/${ROS_DISTRO}/setup.sh \
    && . /opt/intrinsic/intrinsic_sdk_cmake/install/setup.sh \
    && set -x \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache \
    && echo 'APT::Install-Recommends "false";' >/etc/apt/apt.conf.d/99-no-recommends \
    && apt-get update \
    && (rosdep init 2>/dev/null || true) \
    && rosdep update --rosdistro ${ROS_DISTRO} \
    && cd /opt/service_workspace \
    && rosdep install \
        --from-paths src \
        --ignore-src \
        --dependency-types exec \
        -r -y \
    && dpkg --get-selections > /skill_exec_apt_packages.txt

# =========================================================
# STAGE 5: RUNTIME / SKILL STAGE
# =========================================================
FROM ${REPOSITORY}/intrinsic_sdk_cmake_run:${BASE_IMAGE_TAG} AS runtime

ARG ROS_DISTRO=jazzy
ARG SKILL_PACKAGE=moveit_plan_motion_skill
ARG SKILL_EXECUTABLE_NAME=moveit_plan_motion_skill_main
ARG SKILL_CONFIG=share/moveit_plan_motion_skill/moveit_plan_motion_skill_config.pbbin

ENV SERVICE_WORKSPACE=/opt/service_workspace
ENV ROS_DISTRO=${ROS_DISTRO}
ENV SKILL_PACKAGE=${SKILL_PACKAGE}
ENV SKILL_EXECUTABLE_NAME=${SKILL_EXECUTABLE_NAME}
ENV SKILL_CONFIG=${SKILL_CONFIG}
ENV ROS_HOME=/tmp
ENV RMW_IMPLEMENTATION=rmw_zenoh_cpp
ENV ZENOH_CONFIG_OVERRIDE='connect/endpoints=["tcp/zenoh-router.app-intrinsic-base.svc.cluster.local:7447"]'
ENV LD_LIBRARY_PATH=/opt/service_workspace/install/lib:/opt/service_workspace/install/lib/${SKILL_PACKAGE}:/opt/intrinsic/intrinsic_sdk_cmake/install/lib:${LD_LIBRARY_PATH}

COPY --from=exec_depends \
    /skill_exec_apt_packages.txt \
    /skill_exec_apt_packages.txt

RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    set -x \
    && rm -f /etc/apt/apt.conf.d/docker-clean \
    && echo 'Binary::apt::APT::Keep-Downloaded-Packages "true";' >/etc/apt/apt.conf.d/keep-cache \
    && echo 'APT::Install-Recommends "false";' >/etc/apt/apt.conf.d/99-no-recommends \
    && apt-get update \
    && apt-cache dumpavail | dpkg --merge-avail \
    && dpkg --set-selections < /skill_exec_apt_packages.txt \
    && apt-get dselect-upgrade -y -o APT::Solver=internal \
    && rm -f /skill_exec_apt_packages.txt /etc/apt/apt.conf.d/99-no-recommends

COPY --from=build /opt/service_workspace/install /opt/service_workspace/install

RUN sed -i 's/^export ENV ROS_HOME=/export ROS_HOME=/' /ros_entrypoint.sh \
    && sed --in-place \
        --expression '$isource "/opt/intrinsic/intrinsic_sdk_cmake/install/setup.bash"' \
        --expression '$isource "/opt/service_workspace/install/setup.bash"' \
        /ros_entrypoint.sh

# Create runner script with full environment and shared library paths sourced
RUN cat << EOF > /run_skill.sh
#!/bin/bash
set -e
if [ -f "/opt/ros/${ROS_DISTRO}/setup.bash" ]; then
    source "/opt/ros/${ROS_DISTRO}/setup.bash"
fi
if [ -f "/opt/intrinsic/intrinsic_sdk_cmake/install/setup.bash" ]; then
    source "/opt/intrinsic/intrinsic_sdk_cmake/install/setup.bash"
fi
if [ -f "/opt/service_workspace/install/setup.bash" ]; then
    source "/opt/service_workspace/install/setup.bash"
fi
export RMW_IMPLEMENTATION=rmw_zenoh_cpp
export ROS_HOME=/tmp
export ZENOH_CONFIG_OVERRIDE='connect/endpoints=["tcp/zenoh-router.app-intrinsic-base.svc.cluster.local:7447"]'
export LD_LIBRARY_PATH="/opt/service_workspace/install/lib:/opt/service_workspace/install/lib/${SKILL_PACKAGE}:/opt/intrinsic/intrinsic_sdk_cmake/install/lib:\$LD_LIBRARY_PATH"
exec ros2 run "${SKILL_PACKAGE}" "${SKILL_EXECUTABLE_NAME}" "\$@"
EOF
RUN chmod +x /run_skill.sh

# Verify compiled artifacts and link into locations required by Intrinsic Core
RUN set -x \
    && test -x "/opt/service_workspace/install/lib/${SKILL_PACKAGE}/${SKILL_EXECUTABLE_NAME}" \
    && test -f "/opt/service_workspace/install/${SKILL_CONFIG}" \
    && mkdir -p /skills \
    && ln -sf /run_skill.sh /skills/skill_service \
    && ln -sf /opt/service_workspace/install/${SKILL_CONFIG} /skills/skill_service_config.proto.bin

CMD [ \
    "/skills/skill_service", \
    "--skill_service_config_filename=/skills/skill_service_config.proto.bin"]
