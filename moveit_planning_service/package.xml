<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moveit_planning_service</name>
  <version>0.0.1</version>
  <description>Consolidated planning service handling motion planning and grasp planning using MoveIt and MoveIt Task Constructor</description>
  <maintainer email="aaronchong@google.com">Aaron Chong</maintainer>
  <license>Apache License 2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>abseil_cpp_vendor</depend>
  <depend>rclcpp</depend>
  <depend>std_srvs</depend>
  <depend>moveit_msgs</depend>
  <depend>moveit_planning_interfaces</depend>
  <depend>moveit_core</depend>
  <depend>moveit_ros_planning_interface</depend>
  <depend>moveit_task_constructor_core</depend>
  <depend>ament_index_cpp</depend>
  <depend>intrinsic_sdk_cmake</depend>
  <depend>tf2_ros</depend>

  <!-- MoveIt Hardware Config & Execution Dependencies -->
  <exec_depend>robot_hardware_moveit_config</exec_depend>
  <exec_depend>moveit_configs_utils</exec_depend>
  <exec_depend>moveit_ros_move_group</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>controller_manager</exec_depend>

  <test_depend>ament_cmake_gtest</test_depend>
  <test_depend>launch_testing_ament_cmake</test_depend>
  <test_depend>launch_testing_ros</test_depend>
  <test_depend>geometry_msgs</test_depend>
  <test_depend>rclpy</test_depend>
  <test_depend>rmw_zenoh_cpp</test_depend>
  <test_depend>ros2run</test_depend>
  <test_depend>shape_msgs</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
