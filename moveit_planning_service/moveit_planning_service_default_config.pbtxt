# proto-file: moveit_planning_service.proto
# proto-message: MoveItPlanningServiceConfig
[type.googleapis.com/intrinsic.MoveItPlanningServiceConfig] {
  ros_service_call_timeout_sec: 5.0
  add_collision_retry_interval_sec: 2.0
  expect_collision_objects: true
  use_mock_hardware: false
}
