<robot
  name="robot_hardware"
  xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Vendored Intrinsic UR5e description macro -->
  <xacro:include
    filename="$(find robot_hardware_description)/urdf/ur5e/ur5e_macro.xacro"/>

  <!-- Local hardware components -->
  <xacro:include
    filename="$(find robot_hardware_description)/urdf/robotiq_hande/robotiq_hande_macro.xacro"/>

  <xacro:include
    filename="$(find robot_hardware_description)/urdf/orbbec_gemini_335le/orbbec_gemini_335le_macro.xacro"/>

  <!-- UR5e Arm -->
  <xacro:ur5e_robot
    name="ur5e"
    tf_prefix=""
    parent="">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur5e_robot>

  <!-- Robotiq Hand-E, adding 1mm additional opening to grasp 50mm objects -->
  <!-- This has been reflected in third_party/robot_hardware_moveit_config/config/robot_hardware.srdf as well -->
  <xacro:robotiq_hande
    name="robotiq_hande"
    tf_prefix="hande_"
    grip_pos_min="-0.001"
    grip_pos_max="0.025"
    grip_vel_max="0.05"
    grip_effort_min="20"
    grip_effort_max="130"
    initial_pos="0.00655"
    use_ros2_control="false"/>

  <!-- Orbbec Gemini 335Le Camera -->
  <xacro:orbbec_gemini_335le
    name="orbbec_camera"
    tf_prefix="orbbec_camera_"/>

  <!-- UR5e flange -> Hand-E -->
  <joint name="flange_to_hande" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="flange"/>
    <child link="hande_hande_base_link"/>
  </joint>

  <!-- UR5e flange -> Camera -->
  <joint name="flange_to_orbbec_camera" type="fixed">
    <origin xyz="0.025379 0.093008 0.077824" rpy="-0.35550899 0.00730122 3.13241238"/>
    <parent link="flange"/>
    <child link="orbbec_camera_link"/>
  </joint>

</robot>
