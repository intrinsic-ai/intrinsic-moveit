<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:property name="tf_prefix" value="cam_mount/"/>

  <xacro:macro name="camera_mount" params="tf_prefix">

    <link name="${tf_prefix}cam_mount_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.001"/>
        <inertia ixx="0.000001" ixy="0" ixz="0"
                 iyy="0.000001" iyz="0"
                 izz="0.000001"/>
      </inertial>

      <visual name="cam_mount_visual">
        <geometry>
          <mesh filename="package://robot_hardware_description/meshes/camera_mount/cam_mount_visual.obj"/>
        </geometry>
      </visual>

      <collision name="cam_mount_collider_cylinder">
        <origin xyz="0.0 0.0 0.0215" rpy="0.0 0.0 0.0"/>
        <geometry>
          <cylinder radius="0.06" length="0.01"/>
        </geometry>
      </collision>

      <!-- TODO(anyone): Update the colliders to match the [-60, 0, +60] cameras. -->
      <collision name="cam_mount003_collider_box">
        <origin xyz="0.000252 -0.068974 0.0193" rpy="0.0 0.0 -1.570796"/>
        <geometry>
          <box size="0.055675 0.036898 0.0044"/>
        </geometry>
      </collision>

      <collision name="cam_mount003_collider_box.001">
        <origin xyz="0.000189 -0.100267 0.003926" rpy="0.0 1.308997 -1.570796"/>
        <geometry>
          <box size="0.035256 0.04325 0.00858"/>
        </geometry>
      </collision>

      <collision name="cam_mount003_collider_box.002">
        <origin xyz="0.000252 -0.076575 0.007442" rpy="0.0 0.479966 -1.570796"/>
        <geometry>
          <box size="0.059567 0.036898 0.010442"/>
        </geometry>
      </collision>

      <collision name="cam_mount003_collider_box.003">
        <origin xyz="0.059859 -0.034268 0.0193" rpy="0.0 0.0 -0.523599"/>
        <geometry>
          <box size="0.055675 0.036898 0.0044"/>
        </geometry>
      </collision>

      <collision name="cam_mount003_collider_box.004">
        <origin xyz="0.086928 -0.04997 0.003926" rpy="0.0 1.308997 -0.523599"/>
        <geometry>
          <box size="0.035256 0.04325 0.00858"/>
        </geometry>
      </collision>

      <collision name="cam_mount003_collider_box.005">
        <origin xyz="0.06619 -0.037924 0.007593" rpy="0.0 0.479965 -0.523599"/>
        <geometry>
          <box size="0.060221 0.036898 0.010442"/>
        </geometry>
      </collision>

      <collision name="cam_mount003_collider_box.006">
        <origin xyz="-0.059607 -0.034705 0.0193" rpy="0.0 -0.0 -2.617994"/>
        <geometry>
          <box size="0.055675 0.036898 0.0044"/>
        </geometry>
      </collision>

      <collision name="cam_mount003_collider_box.007">
        <origin xyz="-0.08674 -0.050297 0.003926" rpy="0.0 1.308997 -2.617994"/>
        <geometry>
          <box size="0.035256 0.04325 0.00858"/>
        </geometry>
      </collision>

      <collision name="cam_mount003_collider_box.008">
        <origin xyz="-0.066139 -0.038476 0.007473" rpy="0.0 0.479965 -2.617994"/>
        <geometry>
          <box size="0.0597 0.036898 0.010442"/>
        </geometry>
      </collision>


    </link>

  </xacro:macro>

</robot>
