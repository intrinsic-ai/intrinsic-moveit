<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <xacro:macro name="ur5e_robot" params="name tf_prefix parent *origin">

    <!-- Base link -->
    <link name="${tf_prefix}base_link">
      <visual>
        <origin rpy="0 0 3.14159265359" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/visual/base.dae"/>
        </geometry>
      </visual>
      <collision>
        <!--
          TODO(aaronchongth): we use the non-inflated base collision, as well as raising the
          collision by 1cm, to prevent base collision with the mount. This should be revisited and
          fixed when we start using upstream URDFs.
        -->
        <origin rpy="0 0 3.14159265359" xyz="0 0 0.01"/>
        <geometry>
          <!-- <mesh filename="package://robot_hardware_description/urdf/ur5e/collision/base.wrapped.1cm.stl"/> -->
          <mesh filename="package://robot_hardware_description/urdf/ur5e/collision/base.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="4.0"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01"/>
      </inertial>
    </link>

    <!-- Base joint connecting to parent link -->
    <xacro:if value="${parent != ''}">
      <joint name="${tf_prefix}base_joint" type="fixed">
        <xacro:insert_block name="origin" />
        <parent link="${parent}" />
        <child link="${tf_prefix}base_link" />
      </joint>
    </xacro:if>

    <!-- Shoulder pan joint -->
    <joint name="${tf_prefix}shoulder_pan_joint" type="revolute">
      <parent link="${tf_prefix}base_link"/>
      <child link="${tf_prefix}shoulder_link"/>
      <origin rpy="0 0 0" xyz="0 0 0.1625"/>
      <axis xyz="0 0 1"/>
      <limit effort="150.0" lower="-6.2831853" upper="6.2831853" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}shoulder_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/visual/shoulder.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/collision/shoulder.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.761"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01"/>
      </inertial>
    </link>

    <!-- Shoulder lift joint -->
    <joint name="${tf_prefix}shoulder_lift_joint" type="revolute">
      <parent link="${tf_prefix}shoulder_link"/>
      <child link="${tf_prefix}upper_arm_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="150.0" lower="-4.1" upper="0.96" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}upper_arm_link">
      <visual>
        <origin rpy="0 1.57079632679 0" xyz="0 0.138 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/visual/upperarm.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 1.57079632679 0" xyz="0 0.138 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/collision/upperarm.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="8.058"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.28"/>
        <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01"/>
      </inertial>
    </link>

    <!-- Elbow joint -->
    <joint name="${tf_prefix}elbow_joint" type="revolute">
      <parent link="${tf_prefix}upper_arm_link"/>
      <child link="${tf_prefix}forearm_link"/>
      <origin rpy="0 0 0" xyz="0.425 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="150.0" lower="-2.8" upper="2.8" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}forearm_link">
      <visual>
        <origin rpy="0 1.57079632679 0" xyz="0 0.007 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/visual/forearm.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 1.57079632679 0" xyz="0 0.007 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/collision/forearm.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="2.846"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.25"/>
        <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01"/>
      </inertial>
    </link>

    <!-- Wrist 1 joint -->
    <joint name="${tf_prefix}wrist_1_joint" type="revolute">
      <parent link="${tf_prefix}forearm_link"/>
      <child link="${tf_prefix}wrist_1_link"/>
      <origin rpy="0 0 0" xyz="0.3922 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="28.0" lower="-6.2831853" upper="6.2831853" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}wrist_1_link">
      <visual>
        <origin rpy="0 3.14159265359 0" xyz="0 0.007 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/visual/wrist1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 3.14159265359 0" xyz="0 0.007 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/collision/wrist1.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.37"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01"/>
      </inertial>
    </link>

    <!-- Wrist 2 joint -->
    <joint name="${tf_prefix}wrist_2_joint" type="revolute">
      <parent link="${tf_prefix}wrist_1_link"/>
      <child link="${tf_prefix}wrist_2_link"/>
      <origin rpy="0 0 0" xyz="0 0.1333 -0.0997"/>
      <axis xyz="0 0 -1"/>
      <limit effort="28.0" lower="-6.2831853" upper="6.2831853" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}wrist_2_link">
      <visual>
        <origin rpy="0 3.14159265359 0" xyz="0 0 0.0997"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/visual/wrist2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 3.14159265359 0" xyz="0 0 0.0997"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/collision/wrist2.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.3"/>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01"/>
      </inertial>
    </link>

    <!-- Wrist 3 joint -->
    <joint name="${tf_prefix}wrist_3_joint" type="revolute">
      <parent link="${tf_prefix}wrist_2_link"/>
      <child link="${tf_prefix}wrist_3_link"/>
      <origin rpy="-1.57079632679 3.14159265359 0" xyz="0.0 0.0996 0"/>
      <axis xyz="0 0 1"/>
      <limit effort="28.0" lower="-6.2831853" upper="6.2831853" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}wrist_3_link">
      <visual>
        <origin rpy="1.57079632679 0 0" xyz="0 -0.0005 -0.0996"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/visual/wrist3.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.57079632679 0 0" xyz="0 -0.0005 -0.0996"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/urdf/ur5e/collision/wrist3.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.365"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <inertia ixx=".01" ixy="0" ixz="0" iyy=".01" iyz="0" izz=".01"/>
      </inertial>
    </link>

    <!-- Terminal Frame Aliases (flange & tool0) -->
    <link name="${tf_prefix}flange"/>
    <joint name="${tf_prefix}wrist_3_link-flange" type="fixed">
      <parent link="${tf_prefix}wrist_3_link"/>
      <child link="${tf_prefix}flange"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${tf_prefix}tool0"/>
    <joint name="${tf_prefix}flange-tool0" type="fixed">
      <parent link="${tf_prefix}flange"/>
      <child link="${tf_prefix}tool0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
