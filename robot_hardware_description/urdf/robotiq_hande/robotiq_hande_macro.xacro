<robot xmlns:xacro="http://wiki.ros.org/xacro">

  <xacro:include filename="$(find robot_hardware_description)/urdf/robotiq_hande/robotiq_hande.ros2_control.xacro"/>

  <xacro:macro name="robotiq_hande" params="name tf_prefix grip_pos_min grip_pos_max grip_vel_max grip_effort_min grip_effort_max initial_pos use_ros2_control:=false">

    <xacro:if value="${use_ros2_control}">
      <xacro:robotiq_hande_ros2_control
        name="${name}"
        tf_prefix="${tf_prefix}"
        grip_pos_min="${grip_pos_min}"
        grip_pos_max="${grip_pos_max}"
        grip_effort_min="${grip_effort_min}"
        grip_effort_max="${grip_effort_max}"
        initial_pos="${initial_pos}"
      />
    </xacro:if>

    <!-- Base of the gripper -->
    <link name="${tf_prefix}hande_base_link">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="1.0"/>
        <inertia ixx="0.1" ixy="0.0" ixz="0.0"
                 iyy="0.1" iyz="0.0"
                 izz="0.1"/>
      </inertial>

      <visual name="visual1">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/meshes/robotiq_hande/robotiq_hande_body.dae"/>
        </geometry>
      </visual>

      <collision name="collision1">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/meshes/robotiq_hande/robotiq_hande_body_c01.stl"/>
        </geometry>
      </collision>

      <collision name="collision2">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/meshes/robotiq_hande/robotiq_hande_body_c02.stl"/>
        </geometry>
      </collision>
    </link>

    <!-- Fingers and their prismatic joints -->
    <link name="${tf_prefix}hande_finger_link_l">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.00009" iyz="0.0"
                 izz="0.00003"/>
      </inertial>

      <visual name="visual1">
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/meshes/robotiq_hande/robotiq_hande_finger.dae"/>
        </geometry>
      </visual>

      <collision name="collision1">
        <origin xyz="0.028 0 0.15" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.003"/>
        </geometry>
      </collision>

      <collision name="collision2">
        <origin xyz="0.033 0 0.127" rpy="0 0 0"/>
        <geometry>
          <box size="0.005 0.02 0.02"/>
        </geometry>
      </collision>
    </link>

    <link name="${tf_prefix}hande_finger_link_r">
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0"/>
        <mass value="0.2"/>
        <inertia ixx="0.0001" ixy="0.0" ixz="0.0"
                 iyy="0.00009" iyz="0.0"
                 izz="0.00003"/>
      </inertial>

      <visual name="visual1">
        <origin xyz="0 0 0" rpy="0 0 3.14157"/>
        <geometry>
          <mesh filename="package://robot_hardware_description/meshes/robotiq_hande/robotiq_hande_finger.dae"/>
        </geometry>
      </visual>

      <collision name="collision1">
        <origin xyz="-0.028 0 0.15" rpy="0 0 0"/>
        <geometry>
          <sphere radius="0.003"/>
        </geometry>
      </collision>

      <collision name="collision2">
        <origin xyz="-0.033 0 0.127" rpy="0 0 0"/>
        <geometry>
          <box size="0.005 0.02 0.02"/>
        </geometry>
      </collision>
    </link>

    <joint name="${tf_prefix}left_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${tf_prefix}hande_base_link"/>
      <child link="${tf_prefix}hande_finger_link_l"/>
      <axis xyz="-1 0 0"/>
      <limit effort="${grip_effort_max}" lower="${grip_pos_min}" upper="${grip_pos_max}" velocity="${grip_vel_max}"/>
    </joint>

    <joint name="${tf_prefix}right_finger_joint" type="prismatic">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${tf_prefix}hande_base_link"/>
      <child link="${tf_prefix}hande_finger_link_r"/>
      <axis xyz="1 0 0"/>
      <limit effort="${grip_effort_max}" lower="${grip_pos_min}" upper="${grip_pos_max}" velocity="${grip_vel_max}"/>
      <mimic joint="${tf_prefix}left_finger_joint" multiplier="1" offset="0"/>
    </joint>

    <!-- Tool Center Point (TCP) and Tool Frame conventions -->
    <link name="${tf_prefix}tcp"/>

    <joint name="${tf_prefix}attach_tool_frame" type="fixed">
    <!-- NOTE(aaronchongth): decreased z-offset from 0.172 to 0.14 because of constant collisions with scene objects -->
      <origin xyz="0 0 0.14" rpy="0 0 0"/>
      <parent link="${tf_prefix}hande_base_link"/>
      <child link="${tf_prefix}tcp"/>
    </joint>

    <!-- Alias link for Intrinsic Core prefixed tool_frame convention -->
    <link name="${tf_prefix}tool_frame"/>
    <joint name="${tf_prefix}tcp_to_prefixed_tool_frame" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${tf_prefix}tcp"/>
      <child link="${tf_prefix}tool_frame"/>
    </joint>

    <!-- Alias link for Intrinsic Core unqualified tool_frame convention -->
    <link name="tool_frame"/>
    <joint name="${tf_prefix}tcp_to_tool_frame" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${tf_prefix}tcp"/>
      <child link="tool_frame"/>
    </joint>

    <!-- Alias link for Intrinsic Core gripper base convention -->
    <link name="gripper_base_link"/>
    <joint name="${tf_prefix}base_to_gripper_base_link" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${tf_prefix}hande_base_link"/>
      <child link="gripper_base_link"/>
    </joint>

  </xacro:macro>
</robot>
