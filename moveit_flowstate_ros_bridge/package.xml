<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>moveit_flowstate_ros_bridge</name>
  <version>0.0.1</version>
  <description>Flowstate ROS Bridge with a moveit scene bridge plugin</description>
  <maintainer email="johntangz@google.com">johntangz</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>ament_index_cpp</depend>
  <depend>eigen</depend>
  <depend>flowstate_ros_bridge</depend>
  <depend>rclcpp</depend>
  <depend>pluginlib</depend>
  <depend>moveit_msgs</depend>
  <depend>geometric_shapes</depend>
  <depend>shape_msgs</depend>
  <depend>geometry_msgs</depend>
  <depend>lifecycle_msgs</depend>
  <depend>intrinsic_sdk_cmake</depend>

  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
