# proto-file: https://github.com/intrinsic-ai/sdk/blob/main/intrinsic/assets/services/proto/service_manifest.proto
# proto-message: intrinsic_proto.services.ServiceManifest

metadata {
  id {
    package: "ai.intrinsic"
    name: "moveit_flowstate_ros_bridge"
  }
  vendor {
    display_name: "Intrinsic"
  }
  documentation {
    description: "Flowstate ROS bridge for integrating with MoveIt"
  }
  display_name: "MoveIt Flowstate ROS Bridge"
}
service_def {
  supports_service_state: true
  real_spec {
    image {
      archive_filename: "moveit_flowstate_ros_bridge.tar"
    }
  }
  sim_spec {
    image {
      archive_filename: "moveit_flowstate_ros_bridge.tar"
    }
  }
}
assets {
  default_configuration_filename: "default_config.binarypb",
  parameter_descriptor_filename: "parameter-descriptor-set.proto.bin",
  image_filenames: ["moveit_flowstate_ros_bridge.tar"]
}
