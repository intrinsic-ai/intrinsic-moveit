<robot xmlns:xacro="http://wiki.ros.org/xacro">
  <!-- Note: `name` is retained for macro signature parity with `ur5e_robot`. -->
  <xacro:macro name="ur3e_robot" params="name tf_prefix parent *origin">

    <!-- Base link -->
    <link name="${tf_prefix}base_link">
      <visual>
        <origin rpy="0 0 3.14159265359" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/visual/base.dae"/>
        </geometry>
      </visual>
      <collision>
        <!--
          NOTE: Use the non-inflated base collision raised by 1cm to prevent false collisions
          with the base mounting plate, matching ur5e_macro.xacro. Base orientation compensates
          for PublishStaticTransforms rotating ur_module/base_link -> base_link by 180 deg around Z.
        -->
        <origin rpy="0 0 3.14159265359" xyz="0 0 0.01"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/collision/base.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="4.0"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.019392333333333331" ixy="0" ixz="0" iyy="0.019392333333333331" iyz="0" izz="0.032768"/>
      </inertial>
    </link>

    <!-- Base joint connecting to parent link -->
    <xacro:if value="${parent != ''}">
      <joint name="${tf_prefix}base_joint" type="fixed">
        <xacro:insert_block name="origin" />
        <parent link="${parent}" />
        <child link="${tf_prefix}base_link" />
      </joint>
    </xacro:if>

    <!-- Shoulder pan joint -->
    <joint name="${tf_prefix}shoulder_pan_joint" type="revolute">
      <parent link="${tf_prefix}base_link"/>
      <child link="${tf_prefix}shoulder_link"/>
      <origin rpy="0 0 0" xyz="0 0 0.15185"/>
      <axis xyz="0 0 1"/>
      <limit effort="150.0" lower="-6.2831853" upper="6.2831853" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}shoulder_link">
      <visual>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/visual/shoulder.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 0 0" xyz="0 0 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/collision/shoulder.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.98"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.0"/>
        <inertia ixx="0.00283701" ixy="0" ixz="0" iyy="0.003640065" iyz="0" izz="0.002112825"/>
      </inertial>
    </link>

    <!-- Shoulder lift joint -->
    <joint name="${tf_prefix}shoulder_lift_joint" type="revolute">
      <parent link="${tf_prefix}shoulder_link"/>
      <child link="${tf_prefix}upper_arm_link"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="150.0" lower="-4.1" upper="0.96" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}upper_arm_link">
      <visual>
        <origin rpy="0 1.57079632679 0" xyz="0 0.12 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/visual/upperarm.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 1.57079632679 0" xyz="0 0.12 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/collision/upperarm.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="3.4445"/>
        <origin rpy="0 0 0" xyz="0.0 0.12 0.0"/>
        <inertia ixx="0.033749500912083341" ixy="0" ixz="0" iyy="0.032483070208333339" iyz="0" izz="0.006339031037083334"/>
      </inertial>
    </link>

    <!-- Elbow joint -->
    <joint name="${tf_prefix}elbow_joint" type="revolute">
      <parent link="${tf_prefix}upper_arm_link"/>
      <child link="${tf_prefix}forearm_link"/>
      <origin rpy="0 0 0" xyz="0.24355 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="150.0" lower="-2.8" upper="2.8" velocity="3.1415927"/>
    </joint>

    <link name="${tf_prefix}forearm_link">
      <visual>
        <origin rpy="0 1.57079632679 0" xyz="0 0.027 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/visual/forearm.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 1.57079632679 0" xyz="0 0.027 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/collision/forearm.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="1.437"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.27"/>
        <inertia ixx="0.0107173855" ixy="0" ixz="0" iyy="0.0102642515" iyz="0" izz="0.0018003215"/>
      </inertial>
    </link>

    <!-- Wrist 1 joint -->
    <joint name="${tf_prefix}wrist_1_joint" type="revolute">
      <parent link="${tf_prefix}forearm_link"/>
      <child link="${tf_prefix}wrist_1_link"/>
      <origin rpy="0 0 0" xyz="0.2132 0 0"/>
      <axis xyz="0 1 0"/>
      <limit effort="28.0" lower="-6.2831853" upper="6.2831853" velocity="6.2831853"/>
    </joint>

    <link name="${tf_prefix}wrist_1_link">
      <visual>
        <origin rpy="0 3.14159265359 0" xyz="0 0.027 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/visual/wrist1.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 3.14159265359 0" xyz="0 0.027 0"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/collision/wrist1.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.871"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.027"/>
        <inertia ixx="0.0012197629166666669" ixy="0" ixz="0" iyy="0.00098023791666666674" iyz="0" izz="0.00083412766666666658"/>
      </inertial>
    </link>

    <!-- Wrist 2 joint -->
    <joint name="${tf_prefix}wrist_2_joint" type="revolute">
      <parent link="${tf_prefix}wrist_1_link"/>
      <child link="${tf_prefix}wrist_2_link"/>
      <origin rpy="0 0 0" xyz="0 0.13105 -0.08535"/>
      <axis xyz="0 0 -1"/>
      <limit effort="28.0" lower="-6.2831853" upper="6.2831853" velocity="6.2831853"/>
    </joint>

    <link name="${tf_prefix}wrist_2_link">
      <visual>
        <origin rpy="0 3.14159265359 0" xyz="0 0 0.08535"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/visual/wrist2.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="0 3.14159265359 0" xyz="0 0 0.08535"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/collision/wrist2.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.805"/>
        <origin rpy="0 3.14159265359 0" xyz="0 0 0.08535"/>
        <inertia ixx="0.00094138041666666679" ixy="0" ixz="0" iyy="0.00058496666666666677" iyz="0" izz="0.00090596041666666681"/>
      </inertial>
    </link>

    <!-- Wrist 3 joint -->
    <joint name="${tf_prefix}wrist_3_joint" type="revolute">
      <parent link="${tf_prefix}wrist_2_link"/>
      <child link="${tf_prefix}wrist_3_link"/>
      <origin rpy="-1.57079632679 3.14159265359 0" xyz="0.0 0.0921 0"/>
      <axis xyz="0 0 1"/>
      <!--
        NOTE: Tightened from [-1e16, 1e16] in intrinsic-core's ur3e_base.xacro to [-2*pi, +2*pi]
        so MoveIt / OMPL joint-space sampling stays well-conditioned and avoids wrapping the
        tethered wrist camera cable.
      -->
      <limit effort="28.0" lower="-6.2831853" upper="6.2831853" velocity="6.2831853"/>
    </joint>

    <link name="${tf_prefix}wrist_3_link">
      <visual>
        <origin rpy="1.57079632679 0 0" xyz="0 0 -0.0921"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/visual/wrist3.dae"/>
        </geometry>
      </visual>
      <collision>
        <origin rpy="1.57079632679 0 0" xyz="0 0 -0.0921"/>
        <geometry>
          <mesh filename="package://robot_meshes_vendor/meshes/ur3e/collision/wrist3.wrapped.1cm.stl"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="0.261"/>
        <origin rpy="0 0 0" xyz="0.0 0.0 0.029"/>
        <inertia ixx="0.0002981670525" ixy="0" ixz="0" iyy="0.0002981670525" iyz="0" izz="0.000519600105"/>
      </inertial>
    </link>

    <!-- Terminal Frame Aliases (flange & tool0) -->
    <link name="${tf_prefix}flange"/>
    <joint name="${tf_prefix}wrist_3_link-flange" type="fixed">
      <parent link="${tf_prefix}wrist_3_link"/>
      <child link="${tf_prefix}flange"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

    <link name="${tf_prefix}tool0"/>
    <joint name="${tf_prefix}flange-tool0" type="fixed">
      <parent link="${tf_prefix}flange"/>
      <child link="${tf_prefix}tool0"/>
      <origin rpy="0 0 0" xyz="0 0 0"/>
    </joint>

  </xacro:macro>
</robot>
