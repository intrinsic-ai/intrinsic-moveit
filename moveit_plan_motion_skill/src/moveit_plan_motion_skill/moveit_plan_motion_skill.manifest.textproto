# proto-file: https://github.com/intrinsic-ai/sdk/blob/main/intrinsic/skills/proto/skill_manifest.proto
# proto-message: intrinsic_proto.skill.SkillManifest

id {
  package: "ai.intrinsic"
  name: "moveit_plan_motion_skill"
}
display_name: "MoveIt Plan Motion"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description: "Skill that interfaces with the MoveIt Planning Service to compute collision-free geometric motion trajectories."
}
options {
  supports_cancellation: true
  cc_config {
    create_skill: "::com::generic::skills::motion::MotionPlanningSkill::CreateSkill"
  }
}
dependencies {
}
parameter {
  message_full_name: "com.generic.skills.motion.MotionPlanningParams"
  default_value: {
    type_url: "type.googleapis.com/com.generic.skills.motion.MotionPlanningParams"
  }
}
return_type {
  message_full_name: "com.generic.skills.motion.MotionPlanningResult"
}
