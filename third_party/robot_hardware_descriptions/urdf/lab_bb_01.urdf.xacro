<robot
  name="lab_bb_01"
  xmlns:xacro="http://wiki.ros.org/xacro">

  <!-- Vendored Intrinsic UR3e description macro -->
  <xacro:include
    filename="$(find robot_hardware_descriptions)/urdf/ur3e/ur3e_macro.xacro"/>

  <!-- Local hardware components -->
  <xacro:include
    filename="$(find robot_hardware_descriptions)/urdf/robotiq_hande/robotiq_hande_macro.xacro"/>

  <xacro:include
    filename="$(find robot_hardware_descriptions)/urdf/orbbec_gemini_335le/orbbec_gemini_335le_macro.xacro"/>

  <!-- UR3e Arm -->
  <xacro:ur3e_robot
    name="ur3e"
    tf_prefix=""
    parent="">
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </xacro:ur3e_robot>

  <!--
    Robotiq Hand-E, adding 1mm additional opening to grasp 50mm objects (reflected in
    third_party/lab_bb_01_moveit_config/config/lab_bb_01.srdf).
    NOTE: tcp_z_offset="0.128" (and flange_to_hande xyz="0 0 0") matches intrinsic-omts
    configs/lab_bb_01/ur_module.attachments.updates.pbtxt (base -> tool_frame z=0.128, direct
    flange mount without ecat_ft_hal_module). Adjust tcp_z_offset here if scene collision
    clearance tuning is needed on physical hardware.
  -->
  <xacro:robotiq_hande
    name="robotiq_hande"
    tf_prefix="hande_"
    grip_pos_min="-0.001"
    grip_pos_max="0.025"
    grip_vel_max="0.05"
    grip_effort_min="20"
    grip_effort_max="130"
    initial_pos="0.00655"
    tcp_z_offset="0.128"
    use_ros2_control="false"/>

  <!-- Orbbec Gemini 335Le Camera -->
  <xacro:orbbec_gemini_335le
    name="orbbec_camera"
    tf_prefix="orbbec_camera_"/>

  <!-- UR3e flange -> Hand-E (direct mount matching intrinsic-omts lab_bb_01) -->
  <joint name="flange_to_hande" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="flange"/>
    <child link="hande_hande_base_link"/>
  </joint>

  <!-- UR3e flange -> Camera (from intrinsic-omts configs/lab_bb_01/orbbec_gemini.updates.pbtxt) -->
  <joint name="flange_to_orbbec_camera" type="fixed">
    <origin xyz="-0.02384257 -0.06852203 0.03192175" rpy="0.00361469 0.00089883 -0.00419457"/>
    <parent link="flange"/>
    <child link="orbbec_camera_link"/>
  </joint>

</robot>
